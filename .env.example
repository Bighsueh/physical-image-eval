# Root env for docker-compose interpolation (copy to .env for local use; .env is gitignored).
# Backend app env lives separately in backend/.env (see backend/.env.example).

# --- postgres service ---
POSTGRES_USER=pie
POSTGRES_PASSWORD=pie
POSTGRES_DB=physical_image_eval

# --- backend service (compose prod-style run; not used when running backend on host) ---
NODE_ENV=production
DATABASE_URL=postgresql://pie:pie@postgres:5432/physical_image_eval?schema=public
SESSION_ABSOLUTE_TTL=12h
SESSION_IDLE_TTL=60m
COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SID_NAME=pie_sid
COOKIE_CSRF_NAME=pie_csrf
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=15m
BOOTSTRAP_ADMIN_USERNAME=admin
# CHANGE this before any real deploy:
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
