// physical-image-eval — Prisma schema.
// Feature 001 owns the MUTABLE / review-domain auth tables (constitution XI):
//   Account, Session, AuditLog (+ enums Role, AuditAction). Models added in Phase 2 (T013–T016).
// Catalog-domain models (Region/Blueprint/Panel/Diagnosis) belong to feature 002 — not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

/// The two and only two roles (FR-001), strictly separated and server-enforced (FR-011).
enum Role {
  ADMIN // 系統管理員 — account CRUD + dashboard/export (004); never reviews images.
  REVIEWER // 審查者 — reviews images, sees only own records (003).
}

/// Governance operations recorded in the audit trail (FR-023, research D9).
enum AuditAction {
  CREATE_ACCOUNT // 建立帳號
  DISABLE_ACCOUNT // 停用帳號
  ENABLE_ACCOUNT // 啟用帳號
  RESET_CREDENTIAL // 重設憑證
}

// ── Models ───────────────────────────────────────────────────────────────────

/// 帳號（Account）— a person who can enter the system. Exactly one Role each (data-model.md).
model Account {
  id                 String   @id @default(cuid())
  /// Unique, case-insensitive: stored normalized (trim + lower-case) at the boundary (D11).
  username           String   @unique
  /// 顯示名稱 — free text, sanitized on output (FR-006).
  displayName        String
  role               Role
  /// argon2id hash (D3). Never returned by any API, never logged.
  passwordHash       String
  /// false = 停用 / 非在職. Disabled ⇒ all logins fail (FR-007). Default active.
  isActive           Boolean  @default(true)
  /// true after create or reset; forces change on first login (FR-009, D4).
  mustChangePassword Boolean  @default(false)
  passwordUpdatedAt  DateTime @default(now()) @db.Timestamptz(6)
  /// The admin who created this account; null for the bootstrap admin (FR-020).
  createdByAccountId String?
  createdBy          Account?  @relation("AccountCreatedBy", fields: [createdByAccountId], references: [id])
  createdAccounts    Account[] @relation("AccountCreatedBy")
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  sessions        Session[]
  auditActorLogs  AuditLog[] @relation("AuditActor")
  auditTargetLogs AuditLog[] @relation("AuditTarget")
  reviews         Review[] // 003 — reviews this reviewer owns (no cascade on disable, 001 FR-008)

  @@index([role])
  @@index([isActive])
  @@index([createdByAccountId])
}

/// 登入狀態（Session）— one currently-or-formerly valid login. Cookie holds an opaque token
/// whose SHA-256 hash is stored here (D1). Validity is derived, not a stored column.
model Session {
  id         String    @id @default(cuid())
  /// SHA-256 of the opaque cookie token. The raw token is never stored.
  tokenHash  String    @unique
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id])
  /// Per-session double-submit CSRF secret, mirrored to the pie_csrf cookie (D7).
  csrfToken  String
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  /// Absolute expiry = createdAt + SESSION_ABSOLUTE_TTL (D2).
  expiresAt  DateTime  @db.Timestamptz(6)
  /// Sliding idle marker; refreshed ≤ 1/min on authed requests (D2).
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(6)
  /// Set on logout, account disable, or credential reset (FR-017).
  revokedAt  DateTime? @db.Timestamptz(6)

  @@index([accountId])
  @@index([expiresAt])
}

/// 帳號操作軌跡（AuditLog）— append-only governance record (FR-023, D9). Never updated/deleted.
model AuditLog {
  id              String      @id @default(cuid())
  /// Who performed it. null only for the bootstrap seed (system actor).
  actorAccountId  String?
  actor           Account?    @relation("AuditActor", fields: [actorAccountId], references: [id])
  targetAccountId String
  target          Account     @relation("AuditTarget", fields: [targetAccountId], references: [id])
  action          AuditAction
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  /// Optional NON-sensitive context only. Never passwords/temp passwords/hashes/tokens.
  meta            Json?

  @@index([targetAccountId])
  @@index([actorAccountId])
  @@index([createdAt])
}

// ── Catalog domain (feature 002, constitution XI) ───────────────────────────
// READ-ONLY reference data produced solely by ingestion/re-run. Users never create/edit it.

/// The 8 anatomical regions (S/H/E/T/P/K/L/Y).
enum RegionCode {
  S // 肩部
  H // 頭頸部
  E // 肘腕手
  T // 脊椎軀幹
  P // 骨盆髖
  K // 膝部
  L // 小腿足踝
  Y // 全身運動處方
}

/// Diagnosis mapping kind. MAPPED∪TEMPLATE = 128 「對應到藍圖」; REFERRAL = 6. Total 134 (FR-008).
enum MappingKind {
  MAPPED // 已對應 — synonym/same-treatment → a specific non-Y blueprint
  TEMPLATE // 通用處方模板 — systemic diagnosis covered by a Y-series blueprint
  REFERRAL // 轉介 — non-PT; produces no blueprint
}

/// 解剖區域. Seeded entirely by ingestion.
model Region {
  id           String      @id @default(cuid())
  regionCode   RegionCode  @unique
  nameZh       String
  nameEn       String
  displayOrder Int         @unique
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(6)
  blueprints   Blueprint[]
}

/// 藍圖 — one 2×2 four-panel exercise-education image's reference unit.
model Blueprint {
  id                String      @id @default(cuid())
  /// Business key, regex ^[SHETPKLY][1-9][0-9]?$ (FR-022). e.g. S1.
  blueprintId       String      @unique
  regionId          String
  region            Region      @relation(fields: [regionId], references: [id], onDelete: Cascade)
  exerciseName      String
  indications       String
  frequency         String
  gentleReminder    String
  /// Relative path to the single PNG under IMAGE_SOURCE_DIR. Bytes NOT stored (D5).
  imagePath         String      @unique
  sourceMarkdownRef String
  version           String
  /// Hash of normalized parsed fields; powers idempotent diff (D4). Internal — never serialized.
  contentHash       String
  /// Derived: HIGH_RISK_BLUEPRINT_IDS.has(blueprintId) (FR-010).
  isHighRisk        Boolean     @default(false)
  /// INTERNAL-ONLY — stored, never serialized to any API response (FR-020, D7).
  aiPrompt          String
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)
  panels            Panel[]
  diagnoses         Diagnosis[]

  @@index([regionId])
  @@index([isHighRisk])
}

/// 分格 — one cell of a blueprint's 2×2 grid. Exactly 4 per blueprint (FR-004).
model Panel {
  id                String    @id @default(cuid())
  blueprintId       String
  blueprint         Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  panelIndex        Int // 1..4 (app invariant FR-004)
  stepName          String
  actionDescription String
  timingHint        String?
  visualDescription String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([blueprintId, panelIndex])
}

/// 診斷 — one row of the 134-diagnosis mapping matrix (authoritative: 00 index).
model Diagnosis {
  id                String      @id @default(cuid())
  matrixNo          Int         @unique
  nameZh            String
  mappingKind       MappingKind
  /// NOT NULL for MAPPED/TEMPLATE; NULL for REFERRAL.
  mappedBlueprintId String?
  mappedBlueprint   Blueprint?  @relation(fields: [mappedBlueprintId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)

  @@index([mappedBlueprintId])
}

// ── Review domain (feature 003, constitution XI) ────────────────────────────
// MUTABLE review domain. References (read-only) Account (001) + Blueprint (002); never writes them.
// Enum members are ASCII ids @map'd to the verbatim zh-TW labels stored in Postgres (research D2).

/// 整體判定 — single-select, image-level. NULL until submit; required to submit (FR-010/011).
enum OverallJudgement {
  PASS      @map("通過")
  MINOR_FIX @map("需小修")
  REDO      @map("需重做")
}

/// 適應症／診斷對應 — single-select, optional (FR-012).
enum IndicationJudgement {
  REASONABLE @map("合理")
  DOUBTFUL   @map("有疑慮")
}

/// 需要添加的警語 — panel multi-select member (FR-014).
enum WarningType {
  FALL_RISK        @map("注意跌倒")
  NEEDS_ASSISTANCE @map("需有專人幫助指導")
  OSTEOPOROSIS     @map("骨鬆注意")
  CARDIOPULMONARY  @map("心肺功能不全者注意")
  OTHER            @map("其它")
}

/// 問題類型 — panel multi-select member (FR-016).
enum ProblemType {
  WRONG_SUBJECT           @map("部位／主題錯誤")
  WRONG_DEMONSTRATION     @map("動作示範錯誤")
  WRONG_TEXT              @map("文字說明錯誤")
  UNREASONABLE_FREQ_TIME  @map("次數／時間不合理")
  MISSING_SAFETY          @map("缺安全提醒")
  TYPO                    @map("有錯字")
}

/// 審查狀態 — 未開始 is NOT stored (it is the absence of a row); only 草稿/已提交 persist (FR-024).
enum ReviewStatus {
  DRAFT     @map("草稿")
  SUBMITTED @map("已提交")
}

/// 審查 — one reviewer's whole review of one blueprint. Identity = (reviewer × blueprint), unique.
/// References the blueprint by its BUSINESS CODE ('S1'), NOT a FK to Blueprint.id — re-ingestion
/// deletes+recreates all Blueprint rows (new cuids), so a cuid FK would break or cascade-delete
/// review data on every catalog re-ingest. The catalog is resolved by code at read time.
model Review {
  id                  String               @id @default(cuid())
  reviewerId          String
  reviewer            Account              @relation(fields: [reviewerId], references: [id])
  blueprintCode       String // business code e.g. "S1"; resolved against the catalog at read time
  overallJudgement    OverallJudgement?
  indicationJudgement IndicationJudgement?
  indicationNote      String?
  status              ReviewStatus         @default(DRAFT)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  lastSavedAt         DateTime?            @db.Timestamptz(6)
  submittedAt         DateTime?            @db.Timestamptz(6)
  lastUpdatedAt       DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  panels              PanelReview[]

  @@unique([reviewerId, blueprintCode])
  // No standalone @@index([reviewerId]) — the unique + [reviewerId, status] indexes already cover
  // every reviewerId-leading query; a third index would only add write cost (DB review).
  @@index([reviewerId, status])
  @@index([blueprintCode])
}

/// 分格審查 — one reviewer's notes on one panel. Exactly 4 per Review; all fields optional.
model PanelReview {
  id               String        @id @default(cuid())
  reviewId         String
  review           Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  panelIndex       Int
  requiredWarnings WarningType[] @default([])
  warningOther     String?
  problemTypes     ProblemType[] @default([])
  problemNote      String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)

  @@unique([reviewId, panelIndex])
}
