# physical-image-eval backend env (constitution V — all secrets via env, validated at startup).
# Copy to backend/.env for local dev. NEVER commit real secrets (.env is gitignored).

# --- database (dev: Postgres in Docker on host port 5433 → container 5432) ---
DATABASE_URL="postgresql://pie:pie@localhost:5433/physical_image_eval?schema=public"

# --- catalog image source (feature 002) — the READ-ONLY source dir ---
# Absolute, or relative to backend/ (where npm scripts run). Default: the gitignored repo-root copy.
IMAGE_SOURCE_DIR="../images"

# --- server ---
NODE_ENV="development"
PORT="3100"

# --- session / cookie (research D1, D2) ---
SESSION_ABSOLUTE_TTL="12h"        # absolute session lifetime
SESSION_IDLE_TTL="60m"            # idle/sliding timeout
COOKIE_SECURE="false"             # false on http localhost; true in prod (Cloudflared TLS)
COOKIE_DOMAIN=""                  # empty on localhost; the production domain in prod
COOKIE_SID_NAME="pie_sid"
COOKIE_CSRF_NAME="pie_csrf"

# --- password hashing (argon2id, research D3) ---
ARGON2_MEMORY_KIB="19456"
ARGON2_ITERATIONS="2"
ARGON2_PARALLELISM="1"

# --- login rate limit (FR-021, research D8) ---
LOGIN_RATE_MAX="10"
LOGIN_RATE_WINDOW="15m"

# --- first-admin bootstrap (FR-020, research D5) — CHANGE before any real deploy ---
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="change-me-on-first-login"
